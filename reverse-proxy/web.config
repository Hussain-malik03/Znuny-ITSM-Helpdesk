<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for Znuny (requires URL Rewrite + Application Request Routing,
  with "Enable proxy" ticked in ARR Server Proxy Settings, and HTTP_X_FORWARDED_PROTO /
  HTTP_X_FORWARDED_HOST added under URL Rewrite > View Server Variables).
  HTTPS terminates on IIS; traffic is forwarded to Apache/Znuny on the Ubuntu host.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Znuny" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://<ZNUNY_HOST_IP>/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
